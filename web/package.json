{
  "name": "dentflow-studio",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "migrate": "tsx scripts/migrate.ts",
    "test:postgres": "tsx --test tests/postgres.integration.ts",
    "format": "prettier --write app components lib tests scripts proxy.ts next.config.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@vercel/blob": "2.8.0",
    "next": "16.3.8",
    "postgres": "3.4.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-test-renderer": "19.1.0",
    "prettier": "3.8.3",
    "react-test-renderer": "19.2.4",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  }
}
