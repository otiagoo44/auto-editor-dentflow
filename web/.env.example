STUDIO_MODE=LOCAL_STUDIO
APP_DISPLAY_NAME=DentFlow Studio
# Generate a private random value with at least 32 characters; never NEXT_PUBLIC_.
WORKER_TOKEN=
# REMOTE_STUDIO only (owner password protects HTML, APIs, uploads and media):
OWNER_USER=owner
OWNER_PASSWORD=
MEDIA_SIGNING_SECRET=
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# Optional limits:
MAX_UPLOAD_MB=1024
MAX_DURATION_SECONDS=600
MAX_RENDERS_PER_DAY=50
# Local only, defaults outside the repository:
# STUDIO_DATA_DIR=C:/Users/User/AppData/Local/DentFlow/studio
